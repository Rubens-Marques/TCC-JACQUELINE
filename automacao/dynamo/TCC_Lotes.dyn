    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "NodeType": "StringInputNode",
      "InputValue": "{\"dwg\": \"Arquivo Completo- BASE REVIT\", \"dwg_id\": null, \"camadas\": [], \"tipo_lote\": \".LOTE\", \"tolerancia_m\": 0.02, \"area_min_m2\": 40, \"area_max_m2\": 30000, \"ignorar_topo_ids\": [], \"limite\": 10, \"modelo_id\": null, \"recusar_sobreposicao\": true}",
      "Id": "1aa34fba-cdeb-426a-8c3d-e3d7b75d3431",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "58929be3-32b7-44fe-b3f9-95bfcd10d56d",
          "Name": "",
          "Description": "string",
          "UsingDefaultValue": false,
