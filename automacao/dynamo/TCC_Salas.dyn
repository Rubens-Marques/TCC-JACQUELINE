    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "NodeType": "StringInputNode",
      "InputValue": "{\"niveis\": [], \"parede_interna\": \"\", \"parede_externa\": \"\", \"externa_face_interna\": true, \"junta_max_m\": 0.3, \"sem_parede\": [\"patio\", \"pergolado\", \"praca\", \"estacionamento\", \"externa\", \"quadra descoberta\"], \"criar_ambientes\": true, \"piso_oficial\": \"\", \"mapa_setores\": {}}",
      "Id": "9ace99c7-4849-4594-9a02-9023c928d37f",
